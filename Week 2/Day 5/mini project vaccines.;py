class Human:
    """Represents a citizen waiting for vaccination."""

    def __init__(self, id_number, name, age, priority, blood_type):
        self.id_number = id_number
        self.name = name
        self.age = age
        self.priority = priority
        self.blood_type = blood_type
        self.family = []

    def add_family_member(self, person):
        """Add a family member to both humans' family lists."""
        if person not in self.family:
            self.family.append(person)
        if self not in person.family:
            person.family.append(self)


class Queue:
    """Manage the order in which people are vaccinated."""

    def __init__(self):
        self.humans = []

    def add_person(self, person):
        """Add a person to the queue, prioritizing older or priority people."""
        if not self.humans:
            self.humans.append(person)
            return

        if person.age > 60 or person.priority:
            index = 0
            while index < len(self.humans) and not (
                self.humans[index].age > 60 or self.humans[index].priority
            ):
                index += 1
            self.humans.insert(index, person)
            return

        self.humans.append(person)

    def find_in_queue(self, person):
        """Return the index of a person in the queue."""
        for index in range(len(self.humans)):
            if self.humans[index] is person:
                return index
        return -1

    def swap(self, person1, person2):
        """Swap two people in the queue."""
        i = self.find_in_queue(person1)
        j = self.find_in_queue(person2)

        if i == -1 or j == -1:
            return

        self.humans[i], self.humans[j] = self.humans[j], self.humans[i]

    def get_next(self):
        """Return and remove the next person in line."""
        if not self.humans:
            return None
        return self.humans.pop(0)

    def get_next_blood_type(self, blood_type):
        """Return and remove the next person matching a blood type."""
        for index in range(len(self.humans)):
            if self.humans[index].blood_type == blood_type:
                return self.humans.pop(index)
        return None

    def sort_by_age(self):
        """Sort queue order: priority first, then older, then younger."""
        for i in range(len(self.humans)):
            for j in range(0, len(self.humans) - i - 1):
                current = self.humans[j]
                nxt = self.humans[j + 1]

                current_priority = current.priority
                next_priority = nxt.priority
                current_old = current.age > 60
                next_old = nxt.age > 60

                if (current_priority, current_old, current.age) < (
                    next_priority,
                    next_old,
                    nxt.age,
                ):
                    self.humans[j], self.humans[j + 1] = self.humans[j + 1], self.humans[j]

    def rearrange_queue(self):
        """Ensure no two family members are adjacent in the queue."""
        if len(self.humans) < 2:
            return

        changed = True
        while changed:
            changed = False
            for i in range(len(self.humans) - 1):
                current = self.humans[i]
                nxt = self.humans[i + 1]

                if current in nxt.family or nxt in current.family:
                    self.swap(current, nxt)
                    changed = True
                    break


