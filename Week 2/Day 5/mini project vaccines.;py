if __name__ == "__main__":
    human1 = Human("A1", "Alice", 65, False, "A")
    human2 = Human("B2", "Bob", 30, True, "O")
    human3 = Human("C3", "Charlie", 45, False, "AB")
    human4 = Human("D4", "Diana", 72, False, "B")

    queue = Queue()
    queue.add_person(human1)
    queue.add_person(human2)
    queue.add_person(human3)
    queue.add_person(human4)

    print([person.name for person in queue.humans])

    family_member1 = Human("E5", "Emma", 32, False, "A")
    family_member2 = Human("F6", "Frank", 35, False, "O")
    human1.add_family_member(family_member1)
    human2.add_family_member(family_member2)

    queue2 = Queue()
    queue2.add_person(human1)
    queue2.add_person(family_member1)
    queue2.add_person(human2)
    queue2.add_person(family_member2)
    queue2.rearrange_queue()
    print([person.name for person in queue2.humans])
